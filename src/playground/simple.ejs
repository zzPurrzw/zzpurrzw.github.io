<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= htmlWebpackPlugin.options.title %></title>
    <link rel="apple-touch-icon" href="<%= htmlWebpackPlugin.options.root %>favicon.png?v=2">
    <link rel="icon" type="image/png" href="<%= htmlWebpackPlugin.options.root %>favicon.png?v=2">
    <link rel="shortcut icon" href="<%= htmlWebpackPlugin.options.root %>favicon.ico?v=2">
    <link rel="icon" href="<%= htmlWebpackPlugin.options.root %>favicon.ico?v=2" />
    <style>
      body[splash-theme="dark"]:not(.tw-loaded) {
        background: #111;
      }
    </style>
  </head>
  <body>
    <script>
      (function() {
        try {var localTheme = localStorage.getItem('tw:theme');} catch (e) {}
        if (localTheme ? localTheme === 'dark' : true) document.body.setAttribute('splash-theme', 'dark');
      })();
    </script>
    <div id="app"></div>
  </body>
</html>
